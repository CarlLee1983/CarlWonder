---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** 加寬頁面（容納 640 px 正文欄加右側旁欄），寬螢幕才有差別。 */
  wide?: boolean;
}

const { title, description, noindex = false, wide = false } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body class:list={{ wide }}>
    <header>
      <a href="/">CarlWonder</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    max-width: 42rem;
    margin: 0 auto;
    padding: 1rem 1.25rem 4rem;
    color: #1f1f1f;
    background: #fffdf8;
    font-family: system-ui, "Noto Sans TC", "PingFang TC", sans-serif;
    line-height: 1.9;
  }

  a {
    color: #0b4f8a;
  }

  @media (min-width: 62rem) {
    body.wide {
      max-width: 62rem;
    }
  }
</style>
