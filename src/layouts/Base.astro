---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** 加寬頁面（容納 640 px 正文欄加右側旁欄），寬螢幕才有差別。 */
  wide?: boolean;
  /**
   * 頁面自己排欄位：`<main>` 不包 `.page-column`，讓區段可以鋪滿整個視窗寬度，
   * 內容再各自放進 `.page-column`。
   */
  bleed?: boolean;
  /** 首頁自己畫頁首與頁尾。 */
  cover?: boolean;
}

const {
  title,
  description,
  noindex = false,
  wide = false,
  bleed = false,
  cover = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class:list={{ wide, cover }}>
    {
      !cover && (
        <header class="site-header" id="top">
          <a class="wordmark" href="/">
            CarlWonder
          </a>
          <slot name="nav" />
        </header>
      )
    }
    <main class:list={{ "page-column": !bleed && !cover }}>
      <slot />
    </main>
    {
      !cover && (
        <footer class="site-close">
          <a href="/">CarlWonder</a>
          <a href="#top">回到頂端</a>
        </footer>
      )
    }
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --surface: #f4f4f4;
    --ink: #111111;
    --muted: #5c5c5c;
    --accent: #1a4be0;
    --accent-strong: #1239b0;
    --accent-ink: #ffffff;
    --field: #111111;
    --field-ink: #ffffff;
    --field-muted: #b9b9b9;
    --font: "Noto Sans TC", sans-serif;
    --step-small: clamp(0.875rem, 0.84rem + 0.15vw, 0.9375rem);
    --step-body: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    --step-lead: clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem);
    --step-head: clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem);
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-in-out: cubic-bezier(0.76, 0, 0.24, 1);
    --ease-soft: cubic-bezier(0.33, 1, 0.68, 1);
    --t-press: 140ms;
    --t-hover: 180ms;
    --t-reveal: 800ms;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--bg);
    font-family: var(--font);
    font-size: var(--step-body);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0;
  }

  h1,
  h2,
  h3,
  h4 {
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }

  h1 {
    font-size: var(--step-head);
  }

  h2 {
    font-size: var(--step-head);
  }

  h3 {
    font-size: var(--step-lead);
  }

  a {
    color: var(--accent);
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  ::selection {
    background: var(--ink);
    color: var(--bg);
  }

  .wordmark {
    color: var(--ink);
    font-size: var(--step-small);
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .site-header,
  .site-close {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 0;
  }

  .site-close {
    padding-bottom: 2rem;
  }

  .button,
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    border: 0;
    border-radius: 0;
    background: var(--accent);
    color: var(--accent-ink);
    font: inherit;
    font-size: var(--step-body);
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--t-press) var(--ease-out);
  }

  .button:active,
  .btn:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .button:hover,
    .btn:hover {
      background: var(--accent-strong);
    }
  }

  .page-column {
    max-width: 42rem;
    margin: 0 auto;
    padding: 1rem 1.25rem 0;
  }

  main.page-column {
    padding-bottom: 4rem;
  }

  @media (min-width: 62rem) {
    body.wide .page-column,
    body.wide .site-header,
    body.wide .site-close {
      max-width: 62rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
