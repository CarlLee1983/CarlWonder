---
interface Props {
  /** 大人讀完深入正文的分鐘數（reading-time.ts 推估）。 */
  adultMinutes: number;
  /** 親子共學三步驟的合計分鐘數。 */
  familyMinutes: number;
}

const { adultMinutes, familyMinutes } = Astro.props;
---

<div class="doors">
  <a class="door door--adult" href="#reading">
    <span class="door__title">給大人：深入正文</span>
    <span class="door__time">約 {adultMinutes} 分鐘</span>
  </a>
  <a class="door door--family" href="#family">
    <span class="door__title">給家長與 6–10 歲的孩子：親子共學</span>
    <span class="door__time">約 {familyMinutes} 分鐘</span>
  </a>
</div>

<style>
  .doors {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 2.5rem;
  }

  .door {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    min-height: 9rem;
    padding: 1.5rem;
    border-radius: 0.75rem;
    text-decoration: none;
  }

  .door--adult {
    background: #1f2a33;
    color: #f4f1ea;
  }

  .door--family {
    background: #f2c66d;
    color: #2a2112;
  }

  .door__title {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .door__time {
    font-size: 1rem;
  }

  /* 寬螢幕兩扇門並排，窄螢幕上下排。 */
  @media (min-width: 40rem) {
    .doors {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
