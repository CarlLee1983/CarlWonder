---
import type { Family } from "../content/chapter-schema";

interface Props {
  activity: Family["activity"];
}

const { activity } = Astro.props;
---

<article class="card activity-card">
  <h3>家庭探索活動</h3>
  <p class="activity-card__name">{activity.name}</p>
  <ul class="activity-card__meta" aria-label="活動概況">
    <li>{activity.minutes} 分鐘</li>
    <li>{activity.steps.length} 步</li>
    <li>大人要在場</li>
  </ul>

  <h4>材料</h4>
  <ul>
    {activity.materials.map((item) => <li>{item}</li>)}
  </ul>

  <h4>步驟</h4>
  <!-- 勾選只在瀏覽器端：autocomplete="off" 避免重新整理後還原勾選。 -->
  <ol class="activity-card__steps">
    {
      activity.steps.map((step) => (
        <li>
          <label>
            <input type="checkbox" autocomplete="off" />
            <span>{step}</span>
          </label>
        </li>
      ))
    }
  </ol>

  <h4>大人要做什麼</h4>
  <p>{activity.adultRole}</p>

  <h4>和篇章的關係</h4>
  <p>{activity.link}</p>
</article>

<style>
  .activity-card__name {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .activity-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .activity-card__meta li {
    padding: 0.125rem 0.625rem;
    border-radius: 0.375rem;
    background: #f6e7c4;
    font-size: 0.875rem;
  }

  h4 {
    margin: 1rem 0 0.25rem;
  }

  .activity-card__steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .activity-card__steps li {
    margin: 0.5rem 0;
    counter-increment: step;
  }

  .activity-card__steps label {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    cursor: pointer;
  }

  .activity-card__steps label span::before {
    content: counter(step) ". ";
  }

  .activity-card__steps input {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.3rem;
  }

  /* 勾選後把步驟變淡並畫刪除線，純 CSS，不需要 JS。 */
  .activity-card__steps input:checked + span {
    color: #5a4c33;
    text-decoration: line-through;
  }
</style>
