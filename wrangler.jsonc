{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carlwonder",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "carlwonder.gravito.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
